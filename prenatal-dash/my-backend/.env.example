# ─── Server Configuration ──────────────────────────────────────────────
NODE_ENV=production
PORT=5000
JWT_SECRET=change-this-to-a-very-secure-random-string-in-production
JWT_EXPIRES_IN=30d

# ─── Database (PostgreSQL) ────────────────────────────────────────────
# Standard cPanel PostgreSQL parameters:
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cpaneluser_maternalink
DB_USER=cpaneluser_dbuser
DB_PASSWORD=your_secure_db_password

# Or full connection URI if using external DB (e.g. Supabase, Neon, AWS):
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Set DB_SSL=true ONLY if using a cloud/remote database requiring SSL.
# Leave DB_SSL=false for standard local cPanel PostgreSQL.
DB_SSL=false
DB_POOL_MIN=2
DB_POOL_MAX=10

# ─── Firebase (Push Notifications / Admin) ─────────────────────────────
# Path relative to backend root or absolute path on your hosting server
FIREBASE_SERVICE_ACCOUNT_PATH=./secrets/firebase-key.json
FIREBASE_API_KEY=your-firebase-api-key
FIREBASE_PROJECT_ID=your-firebase-project-id

# ─── SMTP (Email Notifications) ───────────────────────────────────────
SMTP_HOST=mail.yourdomain.com
SMTP_PORT=465
SMTP_USER=contact@yourdomain.com
SMTP_PASS=your_email_password
EMAIL_FROM=noreply@yourdomain.com

# ─── CORS (Allowed Origins) ───────────────────────────────────────────
# Comma-separated list of web origins allowed to access the API
ALLOWED_ORIGINS=https://yourdomain.com,https://admin.yourdomain.com

# ─── SMS Provider (AfroMessage) ───────────────────────────────────────
AFROMESSAGE_API_KEY=your_afromessage_api_key
AFROMESSAGE_SENDER_ID=your_afromessage_sender_id

# ─── AI Chatbot (Optional) ────────────────────────────────────────────
OPENAI_API_KEY=sk-your-openai-api-key
CHATBOT_API_URL=https://api.openai.com/v1/chat/completions
