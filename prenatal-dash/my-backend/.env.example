# ─── Server ───────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=30d

# ─── Database (PostgreSQL) ──────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=maternalink
DB_USER=postgres
DB_PASSWORD=postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/maternalink

# ─── Firebase (for OTP Auth + FCM + Storage) ────────────────────────
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
FIREBASE_API_KEY=your-firebase-api-key
FIREBASE_PROJECT_ID=your-firebase-project-id

# ─── SMTP (Email - Admin notifications) ─────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=noreply@maternalink.com

# ─── CORS ────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ─── AI Chatbot API (optional) ──────────────────────────────────────
OPENAI_API_KEY=sk-your-openai-api-key
CHATBOT_API_URL=https://api.openai.com/v1/chat/completions
